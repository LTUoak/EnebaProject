# Copy to frontend/.env.local to override. Values here are public (they end up
# in the browser), so never put secrets in VITE_ variables.

# Address of the backend API. Without it the app uses http://localhost:8000.
# Local backend:    http://localhost:8000
# Deployed backend: https://enebaproject-ggfy.onrender.com
VITE_API_URL=http://localhost:8000
