# Copy to backend/.env and fill in. backend/.env is ignored by git; never commit real values.

# Neon pooled connection string, used by the API
DATABASE_URL=

# Neon direct connection string, used by database/migrate.php and database/seed.php
DATABASE_URL_UNPOOLED=

# Random text of at least 32 characters, used to sign sign-in tokens
APP_SECRET=

# Addresses of the frontend that may call the API, comma-separated
FRONTEND_ORIGINS=http://localhost:5173

# Password of the demo@example.com account (generated by database/seed.php if missing)
SEED_DEMO_PASSWORD=
